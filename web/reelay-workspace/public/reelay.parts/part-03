function saveCanvasFromEditor(enterAfter){
  const name=document.getElementById('canvasEditorName').value.trim();
  const style=document.getElementById('canvasEditorStyle').value;
  if(!name)return pop('请输入画布名称');
  if(canvasEditorContext==='internal'){
    if(project.canvases.some(canvas=>canvas.name===name))return pop('画布名称已存在');
    saveCurrentCanvas();const canvas={id:'cv'+Date.now(),name,style,state:null};project.canvases.push(canvas);activeCanvasId=canvas.id;currentCanvasStyle=style;updateCanvasStylePill();restoreCanvasState(null);closeCanvasEditorPage();renderProject();projectPanel.classList.add('show');projectBtn.classList.add('active');pop(`画布「${name}」已创建 · ${style}风格`);return;
  }
  const p=projectData.find(x=>x.id===activeProjectId);
  if(!p)return pop('当前项目不存在');
  if(p.canvases.some(x=>(typeof x==='string'?x:x.name)===name))return pop('画布名称已存在');
  p.canvases.push(name);
  canvasStyleRegistry[canvasStyleKey(p.id,name)]=style;
  p.updated='刚刚更新';
  closeCanvasEditorPage();renderProjects();openProjectDetail(p.id);
