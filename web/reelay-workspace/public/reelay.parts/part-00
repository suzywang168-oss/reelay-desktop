.permission-tabs{display:flex;gap:6px;padding:10px 12px 5px}
.permission-tab{
  border:1px solid #303035;background:#1c1c1f;color:#8f8f95;border-radius:999px;
  padding:6px 9px;font-size:9px;cursor:pointer
