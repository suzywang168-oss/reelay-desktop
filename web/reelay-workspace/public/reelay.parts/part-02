function scheduleDatabaseSync(){
 if(!databaseHydrated)return;
 clearTimeout(databaseSyncTimer);
 databaseSyncTimer=setTimeout(syncWorkspaceToDatabase,900);
}
async function syncWorkspaceToDatabase(){
 if(databaseSyncBusy||!databaseHydrated)return;
 databaseSyncBusy=true;
 try{
  const current=project.canvases.find(c=>c.id===activeCanvasId);
  if(current)current.state=serializeCurrentCanvas();
  const response=await fetch('/api/workspace',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({
   projectName:project.name,activeCanvasId,payload:{project}
  })});
  if(!response.ok)throw new Error('database save failed');
 }catch(error){console.warn('Reelay database sync failed',error)}
 finally{databaseSyncBusy=false}
}
