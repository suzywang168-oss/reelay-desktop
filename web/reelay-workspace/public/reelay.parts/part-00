}
.confirm-mask{
  position:absolute;inset:0;z-index:160;background:rgba(0,0,0,.52);display:none;align-items:center;justify-content:center
}
.confirm-mask.show{display:flex}
.confirm-box{
  width:390px;background:#161618;border:1px solid #303034;border-radius:16px;padding:18px;
  box-shadow:0 28px 80px rgba(0,0,0,.52)
}
.confirm-box h3{font-size:14px;margin:0 0 8px}
.confirm-box p{font-size:10px;color:#999;line-height:1.7;margin:0}
.confirm-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
.confirm-actions button{
  height:32px;padding:0 12px;border-radius:9px;border:1px solid #34343a;background:#222226;color:#ccc;font-size:9px;cursor:pointer
}
.confirm-actions button.danger{background:#48212a;color:#ffb1be;border-color:#6b2b39}


/* ===== Points & Message Center ===== */
.points-panel,.message-panel{
  position:absolute;right:18px;top:64px;width:340px;max-height:calc(100vh - 82px);
  background:rgba(17,19,24,.96);border:1px solid rgba(255,255,255,.08);border-radius:16px;
  box-shadow:0 24px 70px rgba(0,0,0,.45);backdrop-filter:blur(20px);z-index:66;display:none;overflow:hidden
}
.points-panel.show,.message-panel.show{display:flex;flex-direction:column}
.panel-head{
  height:50px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.07)
}
.panel-head h3{margin:0;font-size:12px}
.panel-head .close-panel{border:0;background:transparent;color:#888;font-size:17px;cursor:pointer}
.points-summary{padding:14px;border-bottom:1px solid rgba(255,255,255,.07)}
.points-total{
  border-radius:14px;padding:18px;background:
  radial-gradient(circle at 80% 20%,rgba(124,140,255,.32),transparent 30%),
  linear-gradient(145deg,#20274c,#151821);
  border:1px solid rgba(255,255,255,.08)
}
.points-total span{font-size:9px;color:#aab0bd}
.points-total b{display:block;font-size:30px;margin:6px 0 10px}
.points-meta{display:flex;justify-content:space-between;font-size:9px;color:#aeb5c2}
.points-actions{display:flex;gap:7px;margin-top:10px}
.points-actions button{
  flex:1;height:32px;border-radius:9px;border:1px solid #34343a;background:#222226;color:#ddd;font-size:9px;cursor:pointer
}
.points-actions button.primary{background:#fff;color:#111;border-color:#fff}
.points-list,.message-list{overflow:auto;padding:8px;display:flex;flex-direction:column;gap:6px}
.points-item,.message-item{
  border:1px solid transparent;border-radius:11px;padding:10px;background:#181a20
}
.points-item{display:grid;grid-template-columns:1fr auto;gap:8px}
.points-item:hover,.message-item:hover{border-color:#32353d;background:#1d2027}
.points-title,.message-title{font-size:10px;color:#eee}
.points-desc,.message-desc{font-size:8px;color:#7f8693;margin-top:3px;line-height:1.5}
.points-value{font-size:10px;font-weight:700}
.points-value.negative{color:#ff9caa}.points-value.positive{color:#70d6a1}
.report-filter{
  display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.07)
}
.report-filter select,.report-filter input{
  height:30px;border:1px solid #34343a;background:#1d2026;color:#ddd;border-radius:8px;padding:0 8px;font-size:9px;outline:none
}
.message-tabs{display:flex;gap:6px;padding:10px 12px 4px}
.message-tab{
  border:1px solid #303035;background:#1c1c1f;color:#8f8f95;border-radius:999px;padding:5px 8px;font-size:9px;cursor:pointer
}
.message-tab.active{background:#f1f1f2;color:#111}
.message-item{position:relative;cursor:pointer}
.message-item.unread::before{
  content:"";position:absolute;left:7px;top:14px;width:6px;height:6px;border-radius:50%;background:#7c8cff
}
.message-item.unread{padding-left:20px}
.message-time{font-size:8px;color:#6f7580;margin-top:5px}
.message-badge{
  position:absolute;right:8px;top:8px;min-width:16px;height:16px;padding:0 4px;border-radius:999px;
  background:#ff5f73;color:#fff;font-size:8px;display:grid;place-items:center
}

/* 画布固定对话框 */
.canvas-chat-launcher{position:absolute;right:22px;bottom:22px;z-index:43;width:44px;height:44px;border:1px solid #41434b;border-radius:50%;background:#f2f2f3;color:#111;box-shadow:0 10px 30px rgba(0,0,0,.36);font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.canvas-chat-launcher:hover{transform:translateY(-1px);background:#fff}
.canvas-chat-launcher.has-panel{background:#25272d;color:#fff}
.canvas-chat{position:absolute;right:22px;bottom:76px;z-index:42;width:340px;height:470px;border:1px solid #34363e;border-radius:16px;background:rgba(20,21,25,.98);box-shadow:0 18px 50px rgba(0,0,0,.48);display:none;overflow:hidden}
.canvas-chat.show{display:flex;flex-direction:column}
.canvas-chat-head{height:54px;flex:0 0 auto;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #2d2f36;background:#18191d}
.canvas-chat-title{display:flex;align-items:center;gap:9px}.canvas-chat-title i{width:8px;height:8px;border-radius:50%;background:#72df9d;box-shadow:0 0 0 4px rgba(114,223,157,.1)}
.canvas-chat-title b{font-size:12px}.canvas-chat-title span{display:block;font-size:8px;color:#858a95;margin-top:3px}
.canvas-chat-close{border:0;background:transparent;color:#888;font-size:20px;cursor:pointer}
.canvas-chat-messages{flex:1;overflow:auto;padding:14px;display:flex;flex-direction:column;gap:12px}
.canvas-chat-msg{max-width:88%;display:flex;flex-direction:column;gap:5px}.canvas-chat-msg.user{align-self:flex-end;align-items:flex-end}.canvas-chat-msg.assistant{align-self:flex-start}
.canvas-chat-bubble{font-size:10px;line-height:1.6;color:#e7e8eb;background:#292b31;border:1px solid #353841;border-radius:12px 12px 12px 4px;padding:9px 11px;white-space:pre-wrap;word-break:break-word}.canvas-chat-msg.user .canvas-chat-bubble{background:#e9eaed;color:#15161a;border-color:#e9eaed;border-radius:12px 12px 4px 12px}
.canvas-chat-node-actions{display:flex;gap:5px}.canvas-chat-node-actions button{border:1px solid #393c45;border-radius:7px;background:#202228;color:#bfc3cc;padding:5px 8px;font-size:8px;cursor:pointer}.canvas-chat-node-actions button:hover{background:#30333b;color:#fff}
.canvas-chat-input{flex:0 0 auto;padding:10px;border-top:1px solid #2d2f36;background:#18191d}.canvas-chat-input textarea{width:100%;height:58px;resize:none;border:1px solid #343740;border-radius:10px;background:#22242a;color:#eee;padding:9px;outline:none;font:10px/1.5 inherit;box-sizing:border-box}.canvas-chat-input textarea:focus{border-color:#666b78}
.canvas-chat-input-foot{display:flex;justify-content:space-between;align-items:center;margin-top:7px}.canvas-chat-input-foot span{font-size:8px;color:#707580}.canvas-chat-send{border:0;border-radius:8px;background:#ededee;color:#111;padding:7px 13px;font-size:9px;font-weight:700;cursor:pointer}.canvas-chat-send:hover{background:#fff}
@media(max-width:700px){.canvas-chat{right:12px;bottom:68px;width:calc(100% - 24px);height:60vh}.canvas-chat-launcher{right:14px;bottom:14px}}
.sidebar-notify-dot{
  position:absolute;width:7px;height:7px;border-radius:50%;background:#ff5f73;right:4px;top:4px;border:2px solid #101011
}
.sidebtn-wrap{position:relative}


.daily-report-card{
  margin:0 14px 12px;padding:12px;border-radius:12px;border:1px solid rgba(124,140,255,.18);
  background:linear-gradient(145deg,rgba(124,140,255,.12),rgba(255,255,255,.025))
}
.daily-report-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.daily-report-head b{font-size:10px}.daily-report-head span{font-size:8px;color:#9ea6b4}
.daily-report-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.daily-stat{padding:8px;border-radius:9px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.05)}
.daily-stat b{display:block;font-size:14px}.daily-stat span{font-size:8px;color:#7f8794}
.daily-report-actions{display:flex;gap:6px;margin-top:9px}
.daily-report-actions button{
  flex:1;height:28px;border-radius:8px;border:1px solid #34343a;background:#222226;color:#ddd;font-size:8px;cursor:pointer
}
.daily-report-actions button.primary{background:#fff;color:#111;border-color:#fff}
.auto-report-note{
  padding:9px 14px;border-bottom:1px solid rgba(255,255,255,.07);font-size:8px;color:#8f96a3;line-height:1.55
}


/* ===== Homepage extensions v29 ===== */
.capability-card{overflow:hidden;padding:0!important}
.capability-card img{width:100%;height:170px;object-fit:cover;display:block}
.capability-card .cap-body{padding:20px}
.capability-card .cap-icon{margin-bottom:14px}

.case-section{background:#0d0e12;overflow:hidden}
.case-track-wrap{overflow:hidden;position:relative}
.case-track{
  display:flex;gap:18px;width:max-content;animation:caseFlow 32s linear infinite;
}
.case-track:hover{animation-play-state:paused}
.case-card{
  width:320px;flex:none;border:1px solid rgba(255,255,255,.08);border-radius:18px;
  overflow:hidden;background:#16181e;box-shadow:0 16px 42px rgba(0,0,0,.24)
}
.case-thumb{height:190px;position:relative;overflow:hidden}
.case-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.case-thumb::after{
  content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.45),transparent 55%)
}
.case-play{
  position:absolute;left:16px;bottom:14px;z-index:2;width:34px;height:34px;border-radius:50%;
  display:grid;place-items:center;background:rgba(255,255,255,.9);color:#111
}
.case-info{padding:14px}
.case-info h3{font-size:13px;margin:0 0 6px}.case-info p{font-size:9px;color:#8f96a3;line-height:1.6;margin:0}
@keyframes caseFlow{from{transform:translateX(0)}to{transform:translateX(-50%)}}

.faq-section{background:#0a0b0f}
.faq-list{display:flex;flex-direction:column;gap:10px;max-width:980px}
.faq-item{
  border:1px solid rgba(255,255,255,.08);background:#15171c;border-radius:14px;overflow:hidden
}
.faq-question{
  width:100%;height:54px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;
  border:0;background:transparent;color:#f4f5f8;text-align:left;font-size:12px;cursor:pointer
}
.faq-question span:last-child{font-size:18px;color:#7f8794}
.faq-answer{display:none;padding:0 16px 16px;color:#9299a5;font-size:10px;line-height:1.8}
.faq-item.open .faq-answer{display:block}
.faq-item.open .faq-question span:last-child{transform:rotate(45deg)}

.link-footer{
  padding:40px 72px 28px;background:#090a0d;border-top:1px solid rgba(255,255,255,.06)
}
.link-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:24px}
.link-brand h3{font-size:18px;margin:0 0 10px}.link-brand p{font-size:10px;color:#7f8794;line-height:1.7;max-width:320px}
.link-col h4{font-size:11px;margin:0 0 12px;color:#d8dbe2}
.link-col a{display:block;color:#7f8794;text-decoration:none;font-size:10px;margin:8px 0}
.link-col a:hover{color:#fff}
.footer-bottom{
  margin-top:34px;padding-top:18px;border-top:1px solid rgba(255,255,255,.06);
  display:flex;justify-content:space-between;color:#666d78;font-size:9px
}
@media(max-width:1100px){
  .link-grid{grid-template-columns:1fr 1fr}
}


/* ===== Permission Management ===== */
.permission-panel{
  position:absolute;left:78px;top:64px;bottom:14px;width:420px;background:rgba(17,19,24,.97);
  border:1px solid rgba(255,255,255,.08);border-radius:16px;z-index:68;display:none;
  flex-direction:column;box-shadow:0 24px 70px rgba(0,0,0,.45);backdrop-filter:blur(22px);overflow:hidden
