 }
 function setCanvasVersion(version,announce=false){
  const general=version==='general';workspace.dataset.canvasVersion=general?'general':'drama';app.dataset.canvasVersion=workspace.dataset.canvasVersion;
  switcher.querySelectorAll('[data-canvas-version]').forEach(button=>button.classList.toggle('active',button.dataset.canvasVersion===workspace.dataset.canvasVersion));
  resourceTitle.textContent='项目与资源';
  if(general)closeDramaTools();
  try{localStorage.setItem('reelay-canvas-version',workspace.dataset.canvasVersion)}catch(error){}
  if(announce&&typeof pop==='function')pop(general?'已切换到通用版 · 保留核心画布工具':'已切换到短剧版 · 完整工具已恢复');
 }
 window.setReelayCanvasVersion=setCanvasVersion;
 switcher.addEventListener('click',event=>{const button=event.target.closest('[data-canvas-version]');if(button)setCanvasVersion(button.dataset.canvasVersion,true)});
