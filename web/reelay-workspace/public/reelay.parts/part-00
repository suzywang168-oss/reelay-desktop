.comment-bubble{box-shadow:0 18px 55px rgba(0,0,0,.35)!important}
.asset-card{transition:.18s ease}
.asset-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(0,0,0,.28)}
.home-footer{background:#090a0d}
.hf-demo-badge{
