function escapeComment(s){
  return s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}
function toggleCommentBubble(id,pin){
  document.querySelectorAll('.comment-bubble').forEach(b=>{
    if(b.dataset.id!==id){b.style.display='none';b.classList.remove('selected')}
  });
  document.querySelectorAll('.comment-pin').forEach(p=>p.classList.remove('active'));
  const bubble=stage.querySelector(`.comment-bubble[data-id="${id}"]`);
  const open=bubble.style.display!=='none';
  bubble.style.display=open?'none':'block';
  pin.classList.toggle('active',!open);
  selectedCommentId=open?null:id;bubble.classList.toggle('selected',!open);
}
function bindCommentBubble(c,bubble,pin){
  bubble.addEventListener('mousedown',()=>{selectedCommentId=c.id;document.querySelectorAll('.comment-bubble').forEach(item=>item.classList.toggle('selected',item===bubble))});
  bubble.querySelector('.comment-close').onclick=()=>{bubble.style.display='none';bubble.classList.remove('selected');pin.classList.remove('active');if(selectedCommentId===c.id)selectedCommentId=null};
  const editor=bubble.querySelector('.comment-editor');
  const replyEditor=bubble.querySelector('.reply-editor');
  const colorPanel=bubble.querySelector('.comment-color-panel');
  bubble.querySelector('.edit-comment').onclick=()=>editor.classList.add('show');
  bubble.querySelector('.cancel-edit').onclick=()=>editor.classList.remove('show');
  bubble.querySelector('.save-edit').onclick=()=>{
    const value=editor.querySelector('textarea').value.trim();
    if(!value)return pop('评论内容不能为空');
    c.text=value;c.created='已编辑';renderComments();pop('评论已更新');
  };
  bubble.querySelector('.reply-comment').onclick=()=>replyEditor.classList.add('show');
  bubble.querySelector('.color-comment').onclick=()=>colorPanel.classList.toggle('show');
  const applyMarkerColor=color=>{
    c.color=color;pin.style.background=color;pin.style.borderColor=color;pin.style.setProperty('--marker-color',color);
    bubble.querySelector('.marker-color-preview').style.background=color;
    colorPanel.querySelector('.marker-color-code').textContent=color;
    colorPanel.querySelectorAll('[data-comment-color]').forEach(x=>x.classList.toggle('active',x.dataset.commentColor.toLowerCase()===color.toLowerCase()));
  };
  colorPanel.querySelectorAll('[data-comment-color]').forEach(btn=>btn.onclick=()=>{applyMarkerColor(btn.dataset.commentColor);pop('标记点颜色已更新')});
  colorPanel.querySelector('.comment-custom-color').oninput=e=>applyMarkerColor(e.target.value);
  colorPanel.querySelector('.comment-custom-color').onchange=()=>pop('标记点颜色已更新');
  bubble.querySelector('.cancel-reply').onclick=()=>replyEditor.classList.remove('show');
  bubble.querySelector('.save-reply').onclick=()=>{
    const value=replyEditor.querySelector('textarea').value.trim();
    if(!value)return pop('请输入回复内容');
    c.replies.push({author:'Suzy',text:value});
    renderComments();
    const np=stage.querySelector(`.comment-pin[data-id="${c.id}"]`);
    toggleCommentBubble(c.id,np);
    pop('回复已发布');
  };
  bubble.querySelectorAll('.reply-item').forEach(item=>{
    const index=Number(item.dataset.replyIndex),inlineEditor=item.querySelector('.reply-inline-editor');
    item.querySelector('.edit-reply').onclick=()=>inlineEditor.classList.add('show');
    item.querySelector('.cancel-reply-edit').onclick=()=>inlineEditor.classList.remove('show');
    item.querySelector('.save-reply-edit').onclick=()=>{const value=inlineEditor.querySelector('textarea').value.trim();if(!value)return pop('回复内容不能为空');c.replies[index].text=value;c.replies[index].edited=true;selectedCommentId=c.id;renderComments();const nextPin=stage.querySelector(`.comment-pin[data-id="${c.id}"]`);toggleCommentBubble(c.id,nextPin);pop('回复已更新')};
    item.querySelector('.delete-reply').onclick=()=>requestDeleteConfirm('删除回复','确定删除这条回复吗？删除后无法恢复。',()=>{c.replies.splice(index,1);selectedCommentId=c.id;renderComments();const nextPin=stage.querySelector(`.comment-pin[data-id="${c.id}"]`);toggleCommentBubble(c.id,nextPin);pop('回复已删除')});
  });
  bubble.querySelector('.delete-comment').onclick=()=>{
    commentDeleteId=c.id;
    commentDeleteMask.classList.add('show');
  };
}

