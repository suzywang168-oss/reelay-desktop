.inline-edit{
  width:100%;background:#202023;border:1px solid #3b3b42;color:#fff;border-radius:8px;
  padding:7px 8px;font-size:10px;outline:none
}
.inline-edit-row{display:flex;gap:6px;margin-top:8px}
.inline-edit-row button{
