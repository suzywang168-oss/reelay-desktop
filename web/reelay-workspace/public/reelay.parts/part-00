/* ===== Hierarchical Sidebar v32 ===== */
#app{grid-template-columns:176px 1fr!important}
.sidebar{
  width:176px!important;padding:14px 10px 12px!important;align-items:stretch!important;
  display:flex!important;flex-direction:column!important;gap:0!important;transition:width .2s ease;
  overflow:visible!important
}
.sidebar.collapsed{width:66px!important}
#app:has(.sidebar.collapsed){grid-template-columns:66px 1fr!important}
.sidebar-top{display:flex;justify-content:center;margin-bottom:12px}
.sidebar .logo{margin:0!important;flex:none}
.nav-group{display:flex;flex-direction:column;gap:5px}
.nav-group-title{
  padding:6px 9px 3px;font-size:8px;color:#606671;letter-spacing:.12em;text-transform:uppercase;
  transition:opacity .15s
}
.nav-separator{height:1px;background:rgba(255,255,255,.06);margin:9px 6px}
.nav-item{
  position:relative;width:100%!important;height:38px!important;border-radius:10px!important;
  display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:10px!important;
  padding:0 10px!important;color:#8f96a3!important
}
.nav-item:hover{color:#fff!important;background:rgba(255,255,255,.07)!important}
.nav-item.active{
  color:#fff!important;background:linear-gradient(90deg,rgba(124,140,255,.18),rgba(124,140,255,.06))!important;
  border-color:rgba(124,140,255,.28)!important
}
.nav-icon{width:20px;display:grid;place-items:center;font-size:14px;flex:none}
.nav-label{font-size:10px;white-space:nowrap;overflow:hidden;transition:opacity .15s,width .15s}
.nav-spacer{flex:1}
.nav-group-bottom{margin-top:8px}
.danger-nav:hover{color:#ff9eae!important;background:rgba(255,95,115,.08)!important}
.sidebar-collapse{
  position:absolute;right:-12px;top:50%;transform:translateY(-50%);
  width:24px;height:42px;border-radius:0 10px 10px 0;border:1px solid rgba(255,255,255,.08);
  background:#17191f;color:#8f96a3;cursor:pointer;z-index:90;font-size:16px
}
.sidebar.collapsed .nav-label,
.sidebar.collapsed .nav-group-title{opacity:0;width:0;padding-left:0;padding-right:0}
.sidebar.collapsed .nav-item{justify-content:center!important;padding:0!important}
.sidebar.collapsed .nav-icon{width:auto}
.sidebar.collapsed .sidebar-collapse{transform:translateY(-50%) rotate(180deg)}
.sidebar.collapsed .nav-separator{margin-left:8px;margin-right:8px}
.sidebar.collapsed .nav-item::after{
  content:attr(title);position:absolute;left:54px;top:50%;transform:translateY(-50%);
  background:#17191f;border:1px solid rgba(255,255,255,.08);color:#ddd;border-radius:8px;
  padding:6px 8px;font-size:9px;white-space:nowrap;opacity:0;pointer-events:none;
