 try{
  const created=await autoCreateNodesFromChat(text,message=>{progress.text=message;renderCanvasChat()}),summary=created.map(n=>n.type==='image'?'图片':n.type==='video'?'视频':'音频').join('、');
  progress.text=`全部完成：已分步创建 ${created.length} 个节点（${summary}），并自动排列和连接。`;renderCanvasChat();pop(`已完成 ${created.length} 个节点`);
 }finally{chatAutoGenerating=false;document.getElementById('canvasChatSend').disabled=false}
}
