function inferChatNodePlan(text){
 const plans=[],rules=[
  {type:'image',label:'图片',regex:/图片|图像|画面|海报|封面|角色图|场景图|概念图|插画|立绘|分镜图/i},
  {type:'video',label:'视频',regex:/视频|动画|镜头|运镜|短片|片段|动态|图生视频/i},
  {type:'audio',label:'音频',regex:/音频|配音|旁白|音乐|音效|声音|对白|语音/i}
 ];
 if(/短剧|故事|剧情|剧本|完整|一集|成片/i.test(text))return[
  {type:'image',label:'角色',name:'主要角色设定',index:1,count:1},
  {type:'image',label:'场景',name:'核心场景设定',index:1,count:1},
  {type:'video',label:'视频',name:'开场镜头',index:1,count:3},
  {type:'video',label:'视频',name:'冲突镜头',index:2,count:3},
  {type:'video',label:'视频',name:'结局镜头',index:3,count:3},
  {type:'audio',label:'声音',name:'配音与音乐',index:1,count:1}
 ];
 rules.forEach(rule=>{
  if(!rule.regex.test(text))return;
  const countMatch=text.match(new RegExp('(\\d+)\\s*(?:个|张|段|条)?(?:'+(rule.type==='image'?'图片|图像|画面|海报|插画|立绘':rule.type==='video'?'视频|动画|镜头|短片|片段':'音频|配音|旁白|音乐|音效')+')','i'));
  const count=Math.max(1,Math.min(6,countMatch?Number(countMatch[1]):1));
  for(let i=0;i<count;i++)plans.push({...rule,index:i+1,count,name:`${rule.label}节点${count>1?' '+(i+1):''}`});
 });
 if(!plans.length)plans.push({type:'image',label:'图片',name:'核心画面',index:1,count:1},{type:'video',label:'视频',name:'动态镜头',index:1,count:1});
 return plans.slice(0,8);
}
const waitChatStep=ms=>new Promise(resolve=>setTimeout(resolve,ms));
let chatAutoGenerating=false;
async function autoCreateNodesFromChat(text,onProgress){
 const plans=inferChatNodePlan(text),vr=viewport.getBoundingClientRect(),baseX=(vr.width*.5-panX)/scale-500,baseY=(vr.height*.34-panY)/scale-170,created=[];
 for(let index=0;index<plans.length;index++){
  const plan=plans[index],col=index%3,row=Math.floor(index/3);
  onProgress?.(`正在生成第 ${index+1}/${plans.length} 步：${plan.name}`);
  await waitChatStep(index===0?420:520);
  const n=createNode(plan.type,baseX+col*345,baseY+row*395);
  n.el.querySelector('.node-name').value=plan.name||('对话生成'+plan.label);
  n.el.querySelector('.prompt').value=text;syncNode(n);created.push(n);
  if(created.length>1&&!links.some(l=>l.from===created[created.length-2].id&&l.to===n.id))links.push({from:created[created.length-2].id,to:n.id});
  refresh();
 }
 if(created.length>1&&typeof createGroup==='function'){
  nodes.forEach(n=>n.el.classList.remove('selected'));created.forEach(n=>n.el.classList.add('selected'));createGroup();
  const group=groups[groups.length-1];if(group){group.name='对话自动生成';const input=group.el.querySelector('.node-group-name');if(input)input.value=group.name}
 }
 if(created[0])locateNode(created[0].id);return created;
}
async function sendCanvasChat(){
