    document.getElementById('canvasEditorName').value='';document.getElementById('canvasEditorStyle').value=currentCanvasStyle||'电影写实';canvasEditorPage.classList.add('show');setTimeout(()=>document.getElementById('canvasEditorName').focus(),0);return;
