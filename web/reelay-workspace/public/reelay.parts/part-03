const renderCommentsBase=renderComments;
renderComments=function(){
  renderCommentsBase();
  comments.forEach(c=>{
    const pin=stage.querySelector(`.comment-pin[data-id="${c.id}"]`);
    const bubble=stage.querySelector(`.comment-bubble[data-id="${c.id}"]`);
    if(!pin||!bubble)return;
    let dragged=false;
    pin.addEventListener('mousedown',e=>{
      if(e.button!==0)return;e.stopPropagation();
      const sx=e.clientX,sy=e.clientY,startX=c.x,startY=c.y;dragged=false;
      const move=v=>{
        const dx=(v.clientX-sx)/scale,dy=(v.clientY-sy)/scale;
        if(Math.abs(dx)+Math.abs(dy)>3)dragged=true;
        c.x=startX+dx;c.y=startY+dy;
        pin.style.left=(c.x-12)+'px';pin.style.top=(c.y-12)+'px';
        bubble.style.left=c.x+'px';bubble.style.top=(c.y-16)+'px';
      };
      const up=()=>{document.removeEventListener('mousemove',move);document.removeEventListener('mouseup',up);if(dragged)pop('评论位置已更新')};
      document.addEventListener('mousemove',move);document.addEventListener('mouseup',up);
    });
    pin.addEventListener('click',e=>{if(dragged){e.preventDefault();e.stopImmediatePropagation();dragged=false}},true);

    const handle=bubble.querySelector('.comment-head');
    handle.style.cursor='move';
    handle.addEventListener('mousedown',e=>{
      if(e.button!==0||e.target.closest('button'))return;e.stopPropagation();e.preventDefault();
      const sx=e.clientX,sy=e.clientY,startX=c.x,startY=c.y;
      const move=v=>{
        c.x=startX+(v.clientX-sx)/scale;c.y=startY+(v.clientY-sy)/scale;
        pin.style.left=(c.x-12)+'px';pin.style.top=(c.y-12)+'px';
        bubble.style.left=c.x+'px';bubble.style.top=(c.y-16)+'px';
      };
      const up=()=>{document.removeEventListener('mousemove',move);document.removeEventListener('mouseup',up);pop('评论位置已更新')};
      document.addEventListener('mousemove',move);document.addEventListener('mouseup',up);
    });
  });
};

