.secondary{background:rgba(255,255,255,.05)!important;border-color:var(--hf-border)!important}
.project-cover::before{
  background:
    radial-gradient(circle at 25% 20%,rgba(124,140,255,.46),transparent 28%),
    linear-gradient(140deg,#252e66,#12151c 72%)!important
