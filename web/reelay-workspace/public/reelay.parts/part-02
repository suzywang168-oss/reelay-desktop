function restoreCanvasState(state){
 clearCanvasStage();
 if(!state){panX=0;panY=0;scale=1;applyTransform();refresh();return}
 const idMap={};
 (state.nodes||[]).forEach(saved=>{
  const n=createNode(saved.type,saved.x,saved.y);idMap[saved.id]=n.id;n.status=saved.status||'待生成';
  const values={'.node-name':saved.name,'.prompt':saved.prompt,'.model':saved.model,'.a':saved.a,'.b':saved.b,'.count':saved.count,'.seed':saved.seed,'.human-review':saved.humanReview};
  Object.entries(values).forEach(([selector,value])=>{const input=n.el.querySelector(selector);if(input&&value!==undefined)input.value=value});
  n.schedule={...(saved.schedule||{enabled:false,time:'',repeat:'once'})};
  n.el.querySelector('.schedule-enabled').checked=!!n.schedule.enabled;n.el.querySelector('.schedule-time').value=n.schedule.time||'';n.el.querySelector('.schedule-repeat').value=n.schedule.repeat||'once';updateNodeSchedule(n);
