function serializeCurrentCanvas(){
 return {panX,panY,scale,links:links.map(l=>({...l})),nodes:nodes.map(n=>({
  id:n.id,type:n.type,x:parseFloat(n.el.style.left)||0,y:parseFloat(n.el.style.top)||0,status:n.status,
