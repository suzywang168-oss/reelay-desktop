/* ===== High Fidelity Layer v22 ===== */
:root{
  --hf-bg:#090a0d;
  --hf-panel:rgba(18,20,26,.88);
  --hf-panel-solid:#14171d;
  --hf-border:rgba(255,255,255,.08);
  --hf-text:#f7f8fb;
  --hf-muted:#8f96a3;
  --hf-brand:#7c8cff;
  --hf-brand2:#5ea1ff;
  --hf-success:#5ed39a;
  --hf-shadow:0 22px 70px rgba(0,0,0,.42);
}
body{background:var(--hf-bg)}
.sidebar{
  width:68px!important;background:rgba(14,15,19,.92)!important;backdrop-filter:blur(18px);
  border-right:1px solid var(--hf-border)!important;padding-top:16px!important
}
.logo{
  width:40px!important;height:40px!important;border-radius:13px!important;background:linear-gradient(145deg,#fff,#dfe4ff)!important;
  box-shadow:0 8px 24px rgba(124,140,255,.22)
}
.sidebtn{
  width:44px!important;height:44px!important;border-radius:13px!important;border-color:var(--hf-border)!important;
  background:rgba(255,255,255,.035)!important;transition:.18s ease
}
.sidebtn:hover,.sidebtn.active{transform:translateY(-1px);background:rgba(255,255,255,.08)!important}
.workspace{
  background-color:#0a0b0f!important;
  background-image:
    radial-gradient(circle at 1px 1px,rgba(255,255,255,.08) 1px,transparent 0)!important;
  background-size:20px 20px!important
}
.topbar .pill{
  background:rgba(18,20,26,.78)!important;border:1px solid var(--hf-border)!important;
  box-shadow:0 10px 30px rgba(0,0,0,.2);backdrop-filter:blur(18px)
}
.node{
  background:rgba(21,24,30,.96)!important;border:1px solid rgba(255,255,255,.08)!important;
  box-shadow:var(--hf-shadow)!important;border-radius:18px!important
}
.node.selected{border-color:rgba(124,140,255,.7)!important;box-shadow:0 0 0 3px rgba(124,140,255,.14),var(--hf-shadow)!important}
.node-head{background:linear-gradient(180deg,rgba(255,255,255,.025),transparent)}
.media{background:#0c0e13!important;border-color:rgba(255,255,255,.07)!important}
.params,.footer{border-color:rgba(255,255,255,.07)!important}
.generate-btn{background:linear-gradient(135deg,#fff,#e5e9ff)!important;box-shadow:0 8px 22px rgba(124,140,255,.16)}
.element-panel,.asset-panel,.share-panel,.project-panel{
  background:rgba(17,19,24,.94)!important;border:1px solid var(--hf-border)!important;
  box-shadow:var(--hf-shadow)!important;backdrop-filter:blur(22px)!important
}
.home-overlay,.project-page,.project-detail-page-unused{background:#0a0b0f!important}
.home-top,.project-page-top,.project-detail-top{
  background:rgba(10,11,15,.8)!important;border-bottom:1px solid var(--hf-border)!important;backdrop-filter:blur(20px)!important
}
.hero{
  background:
    radial-gradient(circle at 80% 10%,rgba(92,108,255,.28),transparent 34%),
    radial-gradient(circle at 20% 0%,rgba(94,161,255,.12),transparent 28%),
    linear-gradient(180deg,#10131f 0,#0a0b0f 100%)!important
}
.hero-video,.film-frame,.feature-image{
  border-color:var(--hf-border)!important;box-shadow:var(--hf-shadow)!important
}
.project-card,.canvas-card,.capability-card,.film-point,.hero-mini-card{
  background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.018))!important;
  border:1px solid var(--hf-border)!important;box-shadow:0 14px 40px rgba(0,0,0,.18)
}
.project-card:hover,.canvas-card:hover,.capability-card:hover{
  transform:translateY(-3px);border-color:rgba(124,140,255,.4)!important
}
.project-create,.primary{
  background:linear-gradient(135deg,#fff,#e8ebff)!important;color:#111!important;
  box-shadow:0 8px 24px rgba(124,140,255,.18)
