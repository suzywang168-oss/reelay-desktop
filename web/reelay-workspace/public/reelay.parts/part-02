   <div class="media-placeholder"><span class="big">${image?'▧':audio?'▥':'<svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M10 8l6 4-6 4z"/></svg>'}</span><span>${typeName}预览</span></div>
