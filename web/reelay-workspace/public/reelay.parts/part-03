/* 项目管理页签与搜索筛选 */
const baseProjectListRenderer=renderProjects;
let projectPageScope='all';
let projectPageKeyword='';
const sharedProjectIds=new Set(['p3']);
renderProjects=function(){
  const allProjects=projectData;
  projectData=allProjects.filter(project=>{
    const ownership=sharedProjectIds.has(project.id)?'shared':'created';
    const scopeMatch=projectPageScope==='all'||projectPageScope===ownership;
    const text=(project.name+' '+project.type+' '+project.desc).toLowerCase();
    return scopeMatch&&(!projectPageKeyword||text.includes(projectPageKeyword));
  });
  baseProjectListRenderer();
  projectData=allProjects;
  if(!projectGrid.children.length){
    projectGrid.innerHTML=`<div style="grid-column:1/-1;padding:70px 20px;text-align:center;border:1px dashed #30333b;border-radius:16px;color:#737a87;font-size:11px">${projectPageKeyword?'没有匹配的项目':projectPageScope==='shared'?'暂无与我共享的项目':'暂无我创建的项目'}</div>`;
  }
};
document.querySelectorAll('.project-tabs .project-tab').forEach((tab,index)=>{
  tab.dataset.projectScope=['all','created','shared'][index];
  tab.onclick=()=>{
    projectPageScope=tab.dataset.projectScope;
    document.querySelectorAll('.project-tabs .project-tab').forEach(item=>item.classList.toggle('active',item===tab));
    renderProjects();
  };
});
const projectPageSearch=document.querySelector('.project-search');
projectPageSearch.oninput=()=>{projectPageKeyword=projectPageSearch.value.trim().toLowerCase();renderProjects()};
renderProjects();

homeOverlay.classList.add('show');
</script>

