.project-card .delete-project-btn{
  position:absolute;right:44px;top:10px;width:28px;height:28px;border-radius:9px;
  border:1px solid rgba(255,95,115,.22);background:rgba(78,25,34,.58);color:#ff9bab;
  display:grid;place-items:center;cursor:pointer;font-size:11px;z-index:3
}
.canvas-card .delete-canvas-btn{
  position:absolute;right:44px;top:10px;width:28px;height:28px;border-radius:9px;
  border:1px solid rgba(255,95,115,.22);background:rgba(78,25,34,.58);color:#ff9bab;
  display:grid;place-items:center;cursor:pointer;font-size:11px;z-index:3
}
.add-canvas-card{
  min-height:188px;border:1px dashed #3c3c43;background:#141417;border-radius:14px;
