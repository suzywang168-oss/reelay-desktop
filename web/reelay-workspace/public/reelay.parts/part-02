  head.setPointerCapture(e.pointerId);e.preventDefault();
 });
 head.addEventListener('pointermove',e=>{
  if(!drag)return;
  let x=drag.startX+e.clientX-drag.clientX,y=drag.startY+e.clientY-drag.clientY;
  x=Math.min(drag.maskRect.right-8-drag.width-drag.baseLeft,Math.max(drag.maskRect.left+8-drag.baseLeft,x));
  y=Math.min(drag.maskRect.bottom-8-drag.height-drag.baseTop,Math.max(drag.maskRect.top+8-drag.baseTop,y));
  modal.dataset.dragX=String(x);modal.dataset.dragY=String(y);modal.style.transform=`translate3d(${x}px,${y}px,0)`;
 });
 const stopDrag=()=>{drag=null};head.addEventListener('pointerup',stopDrag);head.addEventListener('pointercancel',stopDrag);
})();

