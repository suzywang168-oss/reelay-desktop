function renderDirector(){
 const shots=directorOrder.map(id=>nodes.find(n=>n.id===id)).filter(Boolean),total=shots.reduce((sum,n)=>sum+(directorDurations[n.id]||5),0),ready=shots.filter(n=>n.status==='已完成'||n.status==='审核通过').length;
 document.getElementById('directorShotCount').textContent=shots.length;document.getElementById('directorDuration').textContent=total+'s';document.getElementById('directorReady').textContent=(shots.length?Math.round(ready/shots.length*100):0)+'%';
 directorShotList.innerHTML=shots.length?shots.map((n,i)=>`<article class="director-shot ${n.id===directorActiveId?'active':''}" data-shot-id="${n.id}"><div class="director-shot-index">SHOT ${String(i+1).padStart(2,'0')}</div><div class="director-shot-name">${directorNodeName(n)}</div><div class="director-shot-meta">${directorTypeName(n.type)} · ${n.status||'待生成'}</div><div class="director-shot-controls"><button data-dir="prev" title="前移">←</button><button data-dir="next" title="后移">→</button><input data-dir="duration" type="number" min="1" max="120" value="${directorDurations[n.id]||5}" title="镜头时长（秒）"><span style="font-size:7px;color:#737b87">秒</span></div></article>`).join(''):'<div class="director-empty">画布内暂无节点<br>创建节点后点击“同步画布节点”即可开始编排</div>';
 if(directorActiveId){const n=nodes.find(x=>x.id===directorActiveId);if(n)directorPreview.innerHTML=`<div><b>${directorNodeName(n)}</b>${directorTypeName(n.type)}镜头 · ${directorDurations[n.id]||5} 秒<br>${n.status||'待生成'}</div>`}
}
function selectDirectorShot(id,locate=true){directorActiveId=id;renderDirector();if(locate)locateNode(id)}
function stopDirectorPlayback(){clearTimeout(directorTimer);directorTimer=null;directorPlayingIndex=-1;document.getElementById('directorPlay').textContent='▶ 播放';document.getElementById('directorProgress').textContent='播放已停止'}
function playDirectorShot(index){
 if(index>=directorOrder.length){stopDirectorPlayback();document.getElementById('directorProgress').textContent='播放完成';return}
 directorPlayingIndex=index;const id=directorOrder[index],n=nodes.find(x=>x.id===id);if(!n){playDirectorShot(index+1);return}
 selectDirectorShot(id,true);document.getElementById('directorPlay').textContent='❚❚ 暂停';document.getElementById('directorProgress').textContent=`播放中 · ${index+1}/${directorOrder.length} · ${directorNodeName(n)}`;
 directorTimer=setTimeout(()=>playDirectorShot(index+1),(directorDurations[id]||5)*1000);
}
directorBtn.onclick=e=>{e.stopPropagation();const opening=!directorPanel.classList.contains('show');directorPanel.classList.toggle('show',opening);directorBtn.classList.toggle('active',opening);if(opening)syncDirectorNodes();else stopDirectorPlayback()};
document.getElementById('directorClose').onclick=()=>{directorPanel.classList.remove('show');directorBtn.classList.remove('active');stopDirectorPlayback()};
document.getElementById('directorSync').onclick=()=>{syncDirectorNodes();pop('已同步画布节点到导演台')};
document.getElementById('directorPlay').onclick=()=>{if(directorTimer){stopDirectorPlayback();return}if(!directorOrder.length){pop('请先创建画布节点');return}playDirectorShot(Math.max(0,directorPlayingIndex))};
document.getElementById('directorStop').onclick=stopDirectorPlayback;
directorShotList.onclick=e=>{const card=e.target.closest('.director-shot');if(!card)return;const id=card.dataset.shotId,action=e.target.closest('button')?.dataset.dir,index=directorOrder.indexOf(id);if(action){e.stopPropagation();const target=action==='prev'?index-1:index+1;if(target>=0&&target<directorOrder.length){[directorOrder[index],directorOrder[target]]=[directorOrder[target],directorOrder[index]];renderDirector()}return}selectDirectorShot(id,true)};
directorShotList.onchange=e=>{if(e.target.dataset.dir!=='duration')return;const id=e.target.closest('.director-shot').dataset.shotId;directorDurations[id]=Math.max(1,Math.min(120,Number(e.target.value)||1));renderDirector()};
document.getElementById('directorExport').onclick=()=>{syncDirectorNodes();if(!directorOrder.length){pop('暂无可导出的镜头');return}const rows=directorOrder.map((id,i)=>{const n=nodes.find(x=>x.id===id);return `${i+1}. ${directorNodeName(n)}｜${directorTypeName(n.type)}｜${directorDurations[id]}秒｜${n.status}\n   ${n.el.querySelector('.prompt')?.value||'未填写提示词'}`});const blob=new Blob([`Reelay 导演台分镜清单\n生成时间：${new Date().toLocaleString()}\n\n${rows.join('\n\n')}`],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='Reelay-导演台分镜清单.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),500);pop('分镜清单已导出')};

/* 画布固定对话框：对话内容可直接转为节点 */
const canvasChat=document.getElementById('canvasChat'),canvasChatLauncher=document.getElementById('canvasChatLauncher'),
canvasChatMessages=document.getElementById('canvasChatMessages'),canvasChatInput=document.getElementById('canvasChatInput');
let canvasChatHistory=[
 {role:'assistant',text:'你好，我是创作助手。你可以在这里讨论角色、场景或镜头；每条对话都能直接生成图片或视频节点。'},
 {role:'user',text:'雨夜霓虹街道上，女主撑着透明伞回头看向镜头。'},
 {role:'assistant',text:'可以采用中近景，冷蓝环境光搭配暖色霓虹轮廓光，加入雨滴浅景深和轻微手持镜头感。'}
];
function escapeChatText(value){return String(value).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]))}
function renderCanvasChat(){
 canvasChatMessages.innerHTML=canvasChatHistory.map((msg,index)=>`<div class="canvas-chat-msg ${msg.role}">
  <div class="canvas-chat-bubble">${escapeChatText(msg.text)}</div>
  <div class="canvas-chat-node-actions"><button data-chat-node="image" data-chat-index="${index}">＋ 图片节点</button><button data-chat-node="video" data-chat-index="${index}">＋ 视频节点</button></div>
 </div>`).join('');
