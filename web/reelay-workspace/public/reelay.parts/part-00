
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>媒体优先节点编辑器 v8</title>
<style>
:root{
  --bg:#0b0b0c;--grid:#1c1c1f;--card:#161618;--panel:#131315;--panel2:#202023;--border:#2d2d31;
  --text:#f7f7f8;--muted:#85858b;--image:#9fa8ff;--video:#ffad89;--line:#f1f1f1;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);
font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Microsoft YaHei",sans-serif}
button,input,textarea,select{font:inherit}
#app{height:100%;display:grid;grid-template-columns:64px 1fr}
.sidebar{background:#101011;border-right:1px solid #222225;padding:14px 10px;display:flex;flex-direction:column;align-items:start;gap:10px;z-index:70}
.logo{width:36px;height:36px;border-radius:12px;background:#fff;color:#111;display:grid;place-items:center;font-weight:800;margin-bottom:14px}
.sidebtn{width:42px;height:42px;border:1px solid #2a2a2e;border-radius:12px;background:#171719;color:#aaa;cursor:pointer}
.sidebtn:hover,.sidebtn.active{background:#242427;color:#fff}
.workspace{position:relative;overflow:hidden;background-image:radial-gradient(var(--grid) 1px,transparent 1px);background-size:18px 18px;cursor:default}
.workspace.panning{cursor:grabbing}
.topbar{position:absolute;left:18px;right:18px;top:14px;display:flex;justify-content:space-between;z-index:40;pointer-events:none}
.topbar-group{display:flex;gap:8px;pointer-events:auto}
.pill{background:rgba(20,20,22,.88);backdrop-filter:blur(12px);border:1px solid #2c2c30;border-radius:13px;padding:9px 12px;font-size:12px;color:#aaa}
.pill button{border:0;background:transparent;color:#ddd;cursor:pointer}
.share-btn{display:flex;align-items:center;gap:7px;color:#ddd;cursor:pointer}
.share-dot{width:7px;height:7px;border-radius:50%;background:#666}
.share-btn.active .share-dot{background:#62d28f;box-shadow:0 0 0 4px rgba(98,210,143,.12)}

#viewport{position:absolute;inset:0;overflow:hidden}
#stage{position:absolute;left:0;top:0;width:4000px;height:2600px;transform-origin:0 0}
svg{position:absolute;inset:0;width:4000px;height:2600px;overflow:visible;pointer-events:none}

.node{position:absolute;width:310px;background:var(--card);border:1px solid var(--border);border-radius:18px;box-shadow:0 20px 50px rgba(0,0,0,.34);overflow:visible;transition:border-color .15s,box-shadow .15s}
.node.selected{border-color:#777;box-shadow:0 0 0 2px rgba(255,255,255,.08),0 20px 50px rgba(0,0,0,.4)}
.node.flash{animation:flash .8s ease}
.node.remote-hover{box-shadow:0 0 0 3px rgba(104,161,255,.25),0 20px 50px rgba(0,0,0,.42)}
@keyframes flash{0%,100%{box-shadow:0 20px 50px rgba(0,0,0,.34)}50%{box-shadow:0 0 0 4px rgba(255,255,255,.14),0 20px 50px rgba(0,0,0,.5)}}
.node-head{height:42px;padding:0 12px;display:flex;align-items:center;justify-content:space-between;cursor:grab}
.node-title{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:650}
.dot{width:8px;height:8px;border-radius:50%}.image .dot{background:var(--image)}.video .dot{background:var(--video)}
.node-tools{display:flex;gap:2px}.node-tools button{border:0;background:transparent;color:#777;cursor:pointer;font-size:15px}
.node-tools button:hover{color:#fff}

.media{margin:0 10px;height:210px;border-radius:14px;background:#0e0e10;border:1px solid #29292d;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.media::after{position:absolute;inset:0;content:"";background:linear-gradient(to top,rgba(0,0,0,.3),transparent 40%);pointer-events:none}
.media-placeholder{color:#666;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:8px}
.media-placeholder .big{font-size:30px}.video .media-placeholder .big{color:var(--video)}.image .media-placeholder .big{color:var(--image)}
.media-badge,.status-badge{position:absolute;bottom:10px;background:rgba(15,15,17,.78);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:5px 8px;font-size:9px;color:#ddd;z-index:2}
.media-badge{left:10px}.status-badge{right:10px;color:#aaa}.status-badge.running{color:#dce7ff}.status-badge.done{color:#bcf1cf}

.summary{padding:9px 12px 7px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.prompt-summary{font-size:10px;color:#b4b4b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220px}
.expand{border:1px solid #303034;background:#202023;color:#999;border-radius:9px;padding:5px 8px;cursor:pointer;font-size:10px}
.params{display:none;padding:0 12px 10px;border-top:1px solid #28282c}.node.open .params{display:block}.node.open .expand{color:#fff}
.field{margin-top:8px}.field label{display:block;font-size:9px;color:var(--muted);margin-bottom:4px}
.field textarea,.field select,.field input{width:100%;background:#202023;border:1px solid #313136;border-radius:9px;color:#fff;padding:7px 8px;outline:none;font-size:10px;line-height:1.25}
.field textarea{height:52px;resize:none}.field input[type=number]{height:30px}.row{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.reference{padding:7px 8px;border-radius:9px;background:#111113;border:1px dashed #36363b;font-size:9px;line-height:1.45;color:#999;max-height:66px;overflow:auto}
.generate-wrap{padding:0 12px 10px}.generate-btn{width:100%;height:34px;border:0;border-radius:10px;background:#f4f4f5;color:#101012;font-size:10px;font-weight:650;cursor:pointer}
.generate-btn:disabled{opacity:.6}.progress{height:3px;background:#29292d;border-radius:99px;overflow:hidden;margin-top:7px;display:none}.progress span{display:block;height:100%;width:0;background:#fff;transition:width .18s}.node.running .progress{display:block}
.footer{height:38px;border-top:1px solid #29292d;padding:0 12px;display:flex;justify-content:space-between;align-items:center;color:#777;font-size:9px}
.port-group{display:flex;align-items:center;gap:6px}.port{width:12px;height:12px;border-radius:50%;background:#121214;border:2px solid #77777e;cursor:crosshair;pointer-events:auto}
.output{border-color:#f3f3f3}.input.connected{background:#fff}
.link{fill:none;stroke:var(--line);stroke-width:2;opacity:.82}.temp{fill:none;stroke:#777;stroke-width:1.5;stroke-dasharray:5 5}

.node-picker{position:absolute;width:220px;border:1px solid #303034;background:#151517;border-radius:16px;padding:8px;z-index:80;display:none;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.node-picker.show{display:block}.picker-title{font-size:9px;color:#727278;padding:8px 10px 6px}
.node-picker button{width:100%;height:46px;border:0;border-radius:11px;background:transparent;color:#ddd;text-align:left;padding:0 10px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;font-size:11px}
.node-picker button:hover{background:#252528}.picker-meta{font-size:9px;color:#777}

.element-panel{position:absolute;right:14px;top:64px;bottom:14px;width:280px;background:rgba(18,18,20,.94);backdrop-filter:blur(16px);border:1px solid #2b2b2f;border-radius:16px;z-index:55;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.35);transform:translateX(310px);transition:transform .22s ease}
.element-panel.show{transform:translateX(0)}
.element-head{padding:13px 14px 10px;border-bottom:1px solid #29292d;display:flex;align-items:center;justify-content:space-between}
.element-head h3{margin:0;font-size:12px}.element-head span{font-size:9px;color:#777}
.element-search{padding:10px 12px;border-bottom:1px solid #29292d}
.element-search input{width:100%;height:32px;border:1px solid #303035;background:#1d1d20;color:#fff;border-radius:9px;padding:0 10px;font-size:10px;outline:none}
.element-tabs{display:flex;gap:6px;padding:9px 12px 4px}.tab{border:1px solid #303035;background:#1c1c1f;color:#8f8f95;border-radius:999px;padding:5px 8px;font-size:9px;cursor:pointer}.tab.active{background:#f1f1f2;color:#111}
.element-list{padding:8px;overflow:auto;display:flex;flex-direction:column;gap:5px}
.element-item{border:1px solid transparent;border-radius:11px;padding:9px 10px;display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:8px;cursor:pointer}
.element-item:hover{background:#202023;border-color:#2d2d31}.element-item.active{background:#242428;border-color:#3b3b41}
.element-icon{width:28px;height:28px;border-radius:8px;background:#202023;display:grid;place-items:center;font-size:12px}
.element-main{min-width:0}.element-name{font-size:10px;color:#eee;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.element-meta{font-size:8px;color:#777;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.element-status{font-size:8px;color:#8d8d93}.empty{padding:30px 10px;text-align:center;color:#666;font-size:10px}

.share-panel{position:absolute;right:18px;top:64px;width:320px;background:rgba(18,18,20,.97);backdrop-filter:blur(16px);border:1px solid #2b2b2f;border-radius:16px;z-index:60;box-shadow:0 20px 60px rgba(0,0,0,.4);display:none;overflow:hidden}
.share-panel.show{display:block}
.share-head{padding:13px 14px;border-bottom:1px solid #2a2a2e;display:flex;justify-content:space-between;align-items:center}
.share-head h3{font-size:12px;margin:0}.live-badge{font-size:8px;color:#74d79b;background:rgba(116,215,155,.1);padding:4px 7px;border-radius:999px}
.share-section{padding:12px 14px;border-bottom:1px solid #29292d}
.share-label{font-size:9px;color:#777;margin-bottom:6px}
.link-row{display:flex;gap:6px}
.link-row input,.invite-row input{flex:1;height:32px;border:1px solid #303035;background:#1d1d20;color:#ddd;border-radius:9px;padding:0 9px;font-size:9px;outline:none}
.small-btn{height:32px;border:1px solid #303035;background:#232327;color:#ddd;border-radius:9px;padding:0 10px;font-size:9px;cursor:pointer}
.small-btn:hover{background:#2b2b30}
.invite-row{display:flex;gap:6px}
.member-list{padding:8px;max-height:270px;overflow:auto}
.member{display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:9px;padding:8px;border-radius:10px}
.member:hover{background:#202023}
.avatar{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:700;color:#111}
.member-info{min-width:0}.member-name{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.member-state{font-size:8px;color:#777;margin-top:2px}
.member-actions{display:flex;align-items:center;gap:5px}
.role-select{height:27px;border:1px solid #303035;background:#1c1c1f;color:#aaa;border-radius:8px;padding:0 6px;font-size:8px}
.remove-btn{width:27px;height:27px;border:1px solid #3a2c30;background:#251b1e;color:#d98b97;border-radius:8px;font-size:11px;cursor:pointer}
.remove-btn:hover{background:#321f24}
.owner-badge{font-size:8px;color:#f0d18a;background:rgba(240,209,138,.1);padding:4px 6px;border-radius:999px}
.share-note{padding:10px 14px 14px;font-size:9px;color:#777;line-height:1.5}

.remote-cursor{position:absolute;z-index:50;pointer-events:none;transition:left .22s linear,top .22s linear}
.remote-pointer{width:0;height:0;border-left:8px solid transparent;border-right:4px solid transparent;border-bottom:14px solid var(--cursor);transform:rotate(-35deg);filter:drop-shadow(0 1px 2px rgba(0,0,0,.5))}
.remote-label{margin-left:10px;margin-top:-2px;padding:4px 7px;border-radius:7px;background:var(--cursor);color:#111;font-size:8px;font-weight:700;white-space:nowrap}
.remote-halo{position:absolute;width:26px;height:26px;border:2px solid var(--cursor);border-radius:50%;transform:translate(-10px,-10px);opacity:.4;animation:pulse 1.4s infinite}
@keyframes pulse{0%{transform:translate(-10px,-10px) scale(.7);opacity:.5}100%{transform:translate(-10px,-10px) scale(1.35);opacity:0}}

.pan-help{position:absolute;left:18px;bottom:16px;z-index:35;background:rgba(18,18,20,.82);border:1px solid #2b2b2f;border-radius:10px;padding:7px 9px;font-size:9px;color:#777}
.toast{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);background:#f5f5f5;color:#111;border-radius:10px;padding:8px 12px;font-size:10px;opacity:0;transition:.2s;z-index:90}.toast.show{opacity:1}

.comment-bubble{
  position:absolute;z-index:48;min-width:210px;max-width:260px;background:#fff;color:#151517;
  border-radius:14px;padding:10px 11px;box-shadow:0 16px 38px rgba(0,0,0,.28);
  border:1px solid rgba(0,0,0,.08)
}
.comment-bubble::after{
  content:"";position:absolute;left:16px;bottom:-8px;border:8px solid transparent;border-top-color:#fff;border-bottom:0
}
.comment-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
.comment-author{font-size:10px;font-weight:700}
.comment-time{font-size:8px;color:#8b8b91}
.comment-text{font-size:10px;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.comment-actions{display:flex;gap:8px;margin-top:8px}
.comment-actions button{border:0;background:transparent;color:#666;font-size:8px;padding:0;cursor:pointer}
.comment-actions button:hover{color:#111}
.comment-thread{margin-top:8px;padding-top:8px;border-top:1px solid #ececef;display:flex;flex-direction:column;gap:7px}
.reply-item{font-size:9px;line-height:1.45;color:#333}
.reply-item b{font-size:8px}
.reply-editor,.comment-editor{margin-top:8px;display:none}
.reply-editor.show,.comment-editor.show{display:block}
.reply-editor textarea,.comment-editor textarea{
  width:100%;height:54px;resize:none;border:1px solid #d8d8dc;border-radius:9px;padding:7px 8px;
  font-size:9px;outline:none;color:#111;background:#fff
}
.reply-row{display:flex;justify-content:flex-end;gap:6px;margin-top:6px}
.reply-row button{height:26px;border:1px solid #d7d7db;background:#f6f6f7;color:#333;border-radius:8px;padding:0 9px;font-size:8px;cursor:pointer}
.reply-row button.primary{background:#111;color:#fff;border-color:#111}
.reply-item{position:relative;padding:7px 62px 7px 0;border-bottom:1px solid rgba(0,0,0,.06)}.reply-item:last-child{border-bottom:0}.reply-actions{position:absolute;right:0;top:5px;display:flex;gap:3px}.reply-actions button{border:0;background:transparent;color:#818895;font-size:7px;cursor:pointer;padding:2px 3px}.reply-actions button:hover{color:#333}.reply-actions .delete-reply:hover{color:#d95768}.reply-inline-editor{display:none;margin-top:6px}.reply-inline-editor.show{display:block}.reply-inline-editor textarea{width:100%;height:50px;resize:none;border:1px solid #d7d7db;border-radius:8px;padding:6px;font:9px/1.45 inherit}.comment-bubble.selected{outline:2px solid rgba(124,140,255,.56);box-shadow:0 18px 55px rgba(0,0,0,.35),0 0 0 5px rgba(124,140,255,.12)!important}
.comment-pin{
  position:absolute;width:24px;height:24px;border-radius:50%;background:#fff;color:#111;border:1px solid #d8d8dc;
  display:grid;place-items:center;font-size:10px;box-shadow:0 8px 18px rgba(0,0,0,.22);z-index:47;cursor:pointer
}
.comment-pin.active{background:#111;color:#fff;border-color:#111}
.comment-compose{
  position:absolute;width:250px;background:#171719;border:1px solid #303034;border-radius:14px;padding:10px;z-index:85;
  box-shadow:0 18px 50px rgba(0,0,0,.42);display:none
}
.comment-compose.show{display:block}
.comment-compose textarea{
  width:100%;height:70px;resize:none;background:#202023;color:#fff;border:1px solid #35353a;border-radius:10px;
  padding:8px;font-size:10px;outline:none
}
.comment-compose .reply-row button{background:#202023;color:#ccc;border-color:#35353a}
.comment-compose .reply-row button.primary{background:#fff;color:#111;border-color:#fff}
.comment-mode-tip{
  position:absolute;left:78px;bottom:16px;z-index:36;background:rgba(18,18,20,.88);border:1px solid #2b2b2f;
  border-radius:10px;padding:7px 9px;font-size:9px;color:#aaa;display:none
}
.comment-mode-tip.show{display:block}


.asset-panel{
  position:absolute;left:78px;top:64px;bottom:14px;width:330px;background:rgba(18,18,20,.97);
  backdrop-filter:blur(16px);border:1px solid #2b2b2f;border-radius:16px;z-index:62;
  box-shadow:0 20px 60px rgba(0,0,0,.42);display:none;overflow:hidden
}
.asset-panel.show{display:flex;flex-direction:column}
.asset-head{padding:13px 14px;border-bottom:1px solid #29292d;display:flex;align-items:center;justify-content:space-between}
.asset-head h3{margin:0;font-size:12px}.asset-head span{font-size:9px;color:#777}
.asset-search{padding:10px 12px;border-bottom:1px solid #29292d}
.asset-search input{width:100%;height:32px;border:1px solid #303035;background:#1d1d20;color:#fff;border-radius:9px;padding:0 10px;font-size:10px;outline:none}
.asset-tabs{display:flex;gap:6px;padding:9px 12px 5px}
.asset-tab{border:1px solid #303035;background:#1c1c1f;color:#8f8f95;border-radius:999px;padding:5px 8px;font-size:9px;cursor:pointer}
.asset-tab.active{background:#f1f1f2;color:#111}
.asset-grid{padding:8px;overflow:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.asset-card{border:1px solid #2d2d31;background:#19191c;border-radius:12px;overflow:hidden;cursor:pointer}
.asset-card:hover{border-color:#4a4a50;background:#202023}
.asset-cover{height:92px;display:grid;place-items:center;position:relative;background:linear-gradient(145deg,#292932,#121214);font-size:26px}
.asset-cover.portrait{background:linear-gradient(145deg,#35324d,#17151e)}
.asset-cover.scene{background:linear-gradient(145deg,#31463c,#141b17)}
.asset-cover.video{background:linear-gradient(145deg,#4a352e,#1d1512)}
.asset-type{position:absolute;left:7px;top:7px;padding:3px 6px;border-radius:999px;background:rgba(10,10,12,.72);font-size:8px;color:#ddd}
.asset-play{position:absolute;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.88);color:#111;display:grid;place-items:center;font-size:10px}
.asset-info{padding:8px}.asset-name{font-size:10px;color:#eee;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.asset-desc{font-size:8px;color:#777;line-height:1.4;height:23px;overflow:hidden;margin-top:3px}
.asset-actions{display:flex;gap:5px;margin-top:7px}
.asset-actions button{flex:1;height:26px;border:1px solid #333338;background:#232327;color:#bbb;border-radius:8px;font-size:8px;cursor:pointer}
.asset-actions button.primary{background:#f1f1f2;color:#111;border-color:#f1f1f2}
.asset-empty{grid-column:1/-1;padding:34px 10px;text-align:center;color:#666;font-size:10px}
.asset-source{
  position:absolute;left:10px;top:10px;padding:5px 8px;border-radius:8px;background:rgba(15,15,17,.78);
  border:1px solid rgba(255,255,255,.08);font-size:9px;color:#ddd;z-index:2
}


.asset-cover img{width:100%;height:100%;object-fit:cover;display:block}
.asset-card-menu{position:absolute;right:7px;top:7px;z-index:3}
.asset-card-menu button{
  width:25px;height:25px;border:1px solid rgba(255,255,255,.18);border-radius:8px;
  background:rgba(12,12,14,.72);color:#fff;font-size:11px;cursor:pointer
}
.asset-add-card{
  border:1px dashed #3b3b41;background:#151517;border-radius:12px;min-height:160px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer;color:#888
}
.asset-add-card:hover{border-color:#666;color:#fff;background:#1b1b1e}
.asset-add-card .plus{width:34px;height:34px;border-radius:50%;border:1px solid #444;display:grid;place-items:center;font-size:17px}
.asset-add-card span{font-size:9px}

.asset-modal-mask{
  position:absolute;inset:0;background:rgba(0,0,0,.48);z-index:95;display:none;align-items:center;justify-content:center
}
.asset-modal-mask.show{display:flex}
.asset-modal{
  width:430px;background:#161618;border:1px solid #303034;border-radius:17px;box-shadow:0 26px 80px rgba(0,0,0,.5);overflow:hidden
}
.asset-modal-head{height:48px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #29292d}
.asset-modal-head h3{font-size:12px;margin:0}.asset-modal-head button{border:0;background:transparent;color:#888;font-size:17px;cursor:pointer}
.asset-modal-body{padding:14px}
.asset-form-grid{display:grid;grid-template-columns:140px 1fr;gap:12px}
.asset-upload-preview{
  height:150px;border:1px dashed #404047;border-radius:12px;background:#101012;overflow:hidden;
  display:flex;align-items:center;justify-content:center;position:relative
}
.asset-upload-preview img{width:100%;height:100%;object-fit:cover;display:none}
.asset-upload-placeholder{text-align:center;color:#777;font-size:9px;line-height:1.6}
.asset-upload-preview input{position:absolute;inset:0;opacity:0;cursor:pointer}
.asset-form .field:first-child{margin-top:0}
.asset-modal-foot{padding:11px 14px;border-top:1px solid #29292d;display:flex;justify-content:flex-end;gap:7px}
.asset-modal-foot button{height:31px;border:1px solid #343439;background:#222226;color:#ccc;border-radius:9px;padding:0 12px;font-size:9px;cursor:pointer}
