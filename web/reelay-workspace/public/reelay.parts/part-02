const _oldRenderAssetLibrary = renderAssetLibrary;
renderAssetLibrary = function(){
  const backup = assets;
  assets = assetScope==='public' ? publicAssets : projectAssets;
  _oldRenderAssetLibrary();
  assets = backup;

  // Ensure every asset card has a single "调用资产" button
  document.querySelectorAll('.asset-card').forEach(card=>{
      let actions = card.querySelector('.asset-actions');
      if(actions){
          actions.innerHTML='<button class="primary asset-call" style="flex:1">调用资产</button>';
      }
  });

  document.querySelectorAll('.asset-call').forEach(btn=>{
      btn.onclick=(e)=>{
          e.stopPropagation();
          const card=btn.closest('.asset-card');
          const id=card.dataset.assetId;
          const all=[...publicAssets,...projectAssets];
          const asset=all.find(a=>a.id===id);
          if(asset) callAsset(asset);
      };
  });
}


