function createNodeFromChat(type,index){
 const msg=canvasChatHistory[index];if(!msg)return;
 const vr=viewport.getBoundingClientRect(),x=(vr.width*.5-panX)/scale-150,y=(vr.height*.46-panY)/scale-120;
