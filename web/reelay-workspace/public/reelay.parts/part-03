<script>
/* 顶部消息与个人菜单增强 */
(() => {
  const msgButton=document.getElementById('messageBtn');
  const msgPanel=document.getElementById('messagePanel');
  const profileButton=document.getElementById('profileBtn');
  const profileMenu=document.getElementById('profileDropdown');
  const logoButton=document.getElementById('workspaceLogo');
  const logoMenu=document.getElementById('logoDropdown');
  if(!msgButton||!msgPanel||!profileButton||!profileMenu||!logoButton||!logoMenu)return;
  logoButton.onclick=null;

  function positionMessagePanel(){
    const rect=msgButton.getBoundingClientRect();
    const gap=8;
    const panelWidth=Math.min(340,window.innerWidth-24);
    const left=Math.max(12,Math.min(rect.right-panelWidth,window.innerWidth-panelWidth-12));
    msgPanel.style.left=left+'px';
    msgPanel.style.right='auto';
    msgPanel.style.top=(rect.bottom+gap)+'px';
    msgPanel.style.maxHeight=Math.max(240,window.innerHeight-rect.bottom-gap-12)+'px';
  }
  msgButton.addEventListener('click',()=>{
    profileMenu.classList.remove('show');
    profileButton.classList.remove('active');
    profileButton.setAttribute('aria-expanded','false');
    requestAnimationFrame(positionMessagePanel);
  });
  profileButton.addEventListener('click',(event)=>{
    event.stopPropagation();
    const show=!profileMenu.classList.contains('show');
    profileMenu.classList.toggle('show',show);
    profileButton.classList.toggle('active',show);
    profileButton.setAttribute('aria-expanded',String(show));
    if(show&&typeof pointsBalanceValue!=='undefined')document.getElementById('profilePointsBalance').textContent=pointsBalanceValue.toLocaleString();
    if(show&&msgPanel.classList.contains('show'))msgButton.click();
    logoMenu.classList.remove('show');logoButton.setAttribute('aria-expanded','false');
  });
  logoButton.addEventListener('click',(event)=>{
    event.stopPropagation();
    const show=!logoMenu.classList.contains('show');
    logoMenu.classList.toggle('show',show);logoButton.setAttribute('aria-expanded',String(show));
    profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');
    if(msgPanel.classList.contains('show'))msgButton.click();
  });
  document.getElementById('logoGoProjects').addEventListener('click',()=>{
    logoMenu.classList.remove('show');logoButton.setAttribute('aria-expanded','false');
    if(typeof showProjectPage==='function')showProjectPage();
  });
  document.getElementById('logoGoHome').addEventListener('click',()=>{
    logoMenu.classList.remove('show');logoButton.setAttribute('aria-expanded','false');
    if(typeof showHomePage==='function')showHomePage();
  });
  document.getElementById('profilePointsCard').addEventListener('click',()=>{
    profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');
    const btn=document.getElementById('pointsBtn');if(btn&&!document.getElementById('pointsPanel').classList.contains('show'))btn.click();
  });
  const accountMask=document.getElementById('accountSettingsMask'),accountPreview=document.getElementById('accountAvatarPreview');
  let selectedAvatarColor='#343b5b',savedProfile={name:'Suzy',role:'项目管理员',email:'suzy@reelay.ai',phone:'',color:'#343b5b'};
  function closeAccountSettings(){accountMask.classList.remove('show')}
  document.getElementById('profileAccountSettings').addEventListener('click',()=>{
    document.getElementById('accountProfileName').value=savedProfile.name;document.getElementById('accountProfileRole').value=savedProfile.role;document.getElementById('accountProfileEmail').value=savedProfile.email;document.getElementById('accountProfilePhone').value=savedProfile.phone;selectedAvatarColor=savedProfile.color;accountPreview.textContent=savedProfile.name.slice(0,1).toUpperCase();accountPreview.style.background=savedProfile.color;document.querySelectorAll('[data-avatar-color]').forEach(x=>x.classList.toggle('active',x.dataset.avatarColor===savedProfile.color));
    profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');accountMask.classList.add('show');
    setTimeout(()=>document.getElementById('accountProfileName').focus(),0);
  });
  document.querySelectorAll('[data-avatar-color]').forEach(btn=>btn.addEventListener('click',()=>{
    selectedAvatarColor=btn.dataset.avatarColor;document.querySelectorAll('[data-avatar-color]').forEach(x=>x.classList.toggle('active',x===btn));accountPreview.style.background=selectedAvatarColor;
  }));
  document.getElementById('accountProfileName').addEventListener('input',event=>{accountPreview.textContent=event.target.value.trim().slice(0,1).toUpperCase()||'S'});
  document.getElementById('closeAccountSettings').onclick=closeAccountSettings;document.getElementById('cancelAccountSettings').onclick=closeAccountSettings;
  accountMask.addEventListener('mousedown',event=>{if(event.target===accountMask)closeAccountSettings()});
  document.getElementById('saveAccountSettings').onclick=()=>{
    const name=document.getElementById('accountProfileName').value.trim(),role=document.getElementById('accountProfileRole').value.trim(),email=document.getElementById('accountProfileEmail').value.trim(),phone=document.getElementById('accountProfilePhone').value.trim();
    if(!name)return pop('请输入姓名');if(!role)return pop('请输入职位');if(email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return pop('请输入有效的邮箱地址');if(phone&&!/^[+\d\s-]{6,20}$/.test(phone))return pop('请输入有效的手机号');
    const initial=name.slice(0,1).toUpperCase(),background=`linear-gradient(145deg,${selectedAvatarColor},#252a40)`;
    savedProfile={name,role,email,phone,color:selectedAvatarColor};profileButton.textContent=initial;profileButton.style.background=background;document.getElementById('profileMenuAvatar').textContent=initial;document.getElementById('profileMenuAvatar').style.background=background;document.getElementById('profileMenuName').textContent=name;document.getElementById('profileMenuRole').textContent=role;accountPreview.textContent=initial;closeAccountSettings();pop('个人信息已保存');
  };
  function setReadingTheme(theme,notify=false){
    const light=theme==='light';document.getElementById('app').classList.toggle('light-theme',light);document.getElementById('readingDarkMode').classList.toggle('active',!light);document.getElementById('readingLightMode').classList.toggle('active',light);
    try{localStorage.setItem('reelay-reading-theme',theme)}catch(error){}
    if(notify)pop(light?'已切换为浅色阅读模式':'已切换为深色阅读模式');
  }
  document.querySelectorAll('[data-reading-theme]').forEach(btn=>btn.addEventListener('click',event=>{event.stopPropagation();setReadingTheme(btn.dataset.readingTheme,true)}));
  let initialReadingTheme='dark';try{initialReadingTheme=localStorage.getItem('reelay-reading-theme')||'dark'}catch(error){}setReadingTheme(initialReadingTheme);
  document.getElementById('profileHelpCenter').addEventListener('click',()=>{
    profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');
    const faq=document.querySelector('.faq-section')||document.getElementById('faqSection');
    if(typeof showHomePage==='function')showHomePage();
    setTimeout(()=>{if(faq)faq.scrollIntoView({behavior:'smooth',block:'start'});else pop('帮助中心将在正式产品中打开')},80);
  });
  document.getElementById('profileLogout').addEventListener('click',()=>{
    document.getElementById('logoutConfirmMask').classList.add('show');
  });
  document.getElementById('logoutConfirmCancel').addEventListener('click',()=>document.getElementById('logoutConfirmMask').classList.remove('show'));
  document.getElementById('logoutConfirmSubmit').addEventListener('click',()=>{
    document.getElementById('logoutConfirmMask').classList.remove('show');
    profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');
    isAuthenticated=false;pendingAuthDestination=null;
    if(typeof showHomePage==='function')showHomePage();
    pop('已安全退出登录');
  });
  document.getElementById('logoutConfirmMask').addEventListener('mousedown',event=>{if(event.target.id==='logoutConfirmMask')event.currentTarget.classList.remove('show')});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){document.getElementById('logoutConfirmMask').classList.remove('show');closeAccountSettings()}});
  document.addEventListener('click',(event)=>{
    if(!event.target.closest('.topbar-profile-wrap')){
      profileMenu.classList.remove('show');profileButton.classList.remove('active');profileButton.setAttribute('aria-expanded','false');
    }
    if(!event.target.closest('.logo-wrap')){logoMenu.classList.remove('show');logoButton.setAttribute('aria-expanded','false')}
  });
  window.addEventListener('resize',()=>{if(msgPanel.classList.contains('show'))positionMessagePanel()});
})();
</script>
