<script>
/* 画布版本：通用版 / 短剧版 */
(() => {
 const app=document.getElementById('app'),workspace=document.getElementById('workspace'),switcher=document.getElementById('canvasVersionSwitch'),note=document.getElementById('canvasVersionNote'),resourceTitle=document.getElementById('resourceGroupTitle');
 if(!workspace||!switcher)return;
 function closeDramaTools(){
  document.getElementById('skillPanel')?.classList.remove('show');document.getElementById('skillBtn')?.classList.remove('active');
