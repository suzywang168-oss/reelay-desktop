function formatDate(date){
  const y=date.getFullYear(),m=String(date.getMonth()+1).padStart(2,'0'),d=String(date.getDate()).padStart(2,'0');
  return `${y}-${m}-${d}`;
}
function getDailyRecords(dateStr){
  return pointsRecords.filter(r=>r.date.startsWith(dateStr));
}
function updateDailyReport(){
  const today=formatDate(new Date());
  const records=getDailyRecords(today);
  const income=records.filter(r=>r.value>0).reduce((s,r)=>s+r.value,0);
  const expense=Math.abs(records.filter(r=>r.value<0).reduce((s,r)=>s+r.value,0));
  const net=income-expense;
  document.getElementById('dailyReportDate').textContent=today;
  document.getElementById('dailyIncome').textContent='+'+income;
  document.getElementById('dailyExpense').textContent='-'+expense;
  document.getElementById('dailyNet').textContent=(net>=0?'+':'')+net;
}
function downloadReport(records,filename){
  const rows=[['时间','人员','项目/说明','媒体类型','生成参数','积分变化'],...records.map(r=>[r.date,r.member||'系统',r.title+' - '+r.desc,r.mediaType||'—',(r.params||[]).join(' / ')||'—',r.value])];
  const csv=rows.map(row=>row.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.download=filename;a.click();
  URL.revokeObjectURL(url);
}
function generateDailyReport(manual=false){
  const today=formatDate(new Date());
  updateDailyReport();
  if(!messages.some(m=>m.type==='points'&&m.title.includes(today))){
    messages.unshift({
      id:'m'+Date.now(),
      type:'points',
      title:`${today} 积分日报已生成`,
      desc:'系统已自动生成今日积分日报，可前往积分中心查看或下载。',
      time:'刚刚',
      unread:true
    });
  }
  renderMessages();
  updateMessageDot();
  if(manual) pop('积分日报已生成，并发送消息提醒');
}

/* 列表浮层：标题栏拖拽 + 右下角自由缩放 */
let floatingPanelZ=180;
function enableFloatingListPanels(){
 const selector='.project-panel,.asset-panel,.permission-panel,.points-panel,.message-panel,.element-panel,.share-panel,.director-panel';
 document.querySelectorAll(selector).forEach(panel=>{
  if(panel.dataset.floatingReady)return;
  panel.dataset.floatingReady='true';panel.classList.add('floating-list-panel');
  const handle=panel.querySelector('.panel-title-row')||panel.querySelector('.asset-head')||panel.querySelector('.permission-head')||panel.querySelector('.panel-head')||panel.querySelector('.element-head')||panel.querySelector('.share-head')||panel.querySelector('.director-head')||panel.querySelector('.project-head');
  const resize=document.createElement('span');resize.className='floating-panel-resize';resize.title='拖动调整窗口大小';panel.appendChild(resize);
  panel.addEventListener('mousedown',()=>{panel.style.zIndex=String(++floatingPanelZ)});
  if(handle)handle.addEventListener('mousedown',e=>{
   if(e.button!==0||e.target.closest('button,input,select,textarea,a'))return;
   e.preventDefault();e.stopPropagation();
   const rect=panel.getBoundingClientRect(),parent=panel.offsetParent||document.body,parentRect=parent.getBoundingClientRect();
   const offsetX=e.clientX-rect.left,offsetY=e.clientY-rect.top;
   panel.style.left=(rect.left-parentRect.left)+'px';panel.style.top=(rect.top-parentRect.top)+'px';panel.style.right='auto';panel.style.bottom='auto';panel.style.transform='none';panel.style.zIndex=String(++floatingPanelZ);panel.classList.add('is-moving');
   const move=ev=>{
    const maxLeft=Math.max(8,parentRect.width-panel.offsetWidth-8),maxTop=Math.max(8,parentRect.height-panel.offsetHeight-8);
    panel.style.left=Math.min(maxLeft,Math.max(8,ev.clientX-parentRect.left-offsetX))+'px';
    panel.style.top=Math.min(maxTop,Math.max(8,ev.clientY-parentRect.top-offsetY))+'px';
   };
   const up=()=>{panel.classList.remove('is-moving');document.removeEventListener('mousemove',move);document.removeEventListener('mouseup',up)};
   document.addEventListener('mousemove',move);document.addEventListener('mouseup',up);
  });
  if(handle){
   handle.title='双击收起或展开列表';
   handle.addEventListener('dblclick',e=>{
    if(panel.id==='elementPanel'||panel.id==='directorPanel')return;
    if(e.target.closest('button,input,select,textarea,a'))return;
    e.preventDefault();e.stopPropagation();
    const collapsed=panel.classList.contains('panel-collapsed');
    if(collapsed){
      panel.classList.remove('panel-collapsed');
      if(panel.dataset.expandedHeight)panel.style.height=panel.dataset.expandedHeight;
    }else{
      panel.dataset.expandedHeight=panel.style.height||panel.getBoundingClientRect().height+'px';
      panel.classList.add('panel-collapsed');
    }
   });
  }
  resize.addEventListener('mousedown',e=>{
   if(e.button!==0)return;e.preventDefault();e.stopPropagation();
   const rect=panel.getBoundingClientRect(),parent=panel.offsetParent||document.body,parentRect=parent.getBoundingClientRect();
   const startX=e.clientX,startY=e.clientY,startW=rect.width,startH=rect.height,minW=panel.id==='directorPanel'?480:260,minH=panel.id==='directorPanel'?260:220;
   panel.style.left=(rect.left-parentRect.left)+'px';panel.style.top=(rect.top-parentRect.top)+'px';panel.style.right='auto';panel.style.bottom='auto';panel.style.transform='none';panel.style.maxHeight='none';panel.style.zIndex=String(++floatingPanelZ);panel.classList.add('is-resizing');
   const move=ev=>{
    const maxW=Math.max(minW,parentRect.right-rect.left-8),maxH=Math.max(minH,parentRect.bottom-rect.top-8);
    panel.style.width=Math.min(maxW,Math.max(minW,startW+ev.clientX-startX))+'px';
    panel.style.height=Math.min(maxH,Math.max(minH,startH+ev.clientY-startY))+'px';
   };
   const up=()=>{panel.classList.remove('is-resizing');document.removeEventListener('mousemove',move);document.removeEventListener('mouseup',up)};
   document.addEventListener('mousemove',move);document.addEventListener('mouseup',up);
  });
 });
}
function enableLeftPanelPlacement(){
 const panels=document.querySelectorAll('.project-panel,.asset-panel,.permission-panel,.points-panel,.message-panel,.element-panel,.share-panel');
 panels.forEach(panel=>{
