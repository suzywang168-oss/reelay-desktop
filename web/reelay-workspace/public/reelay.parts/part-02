function syncDirectorNodes(){
 const ids=nodes.map(n=>n.id);directorOrder=directorOrder.filter(id=>ids.includes(id));ids.forEach(id=>{if(!directorOrder.includes(id))directorOrder.push(id)});
 directorOrder.forEach(id=>{if(!directorDurations[id]){const n=nodes.find(x=>x.id===id),raw=n?.el.querySelector('.a')?.value||'';directorDurations[id]=parseInt(raw)|| (n?.type==='image'?3:5)}});
 if(directorActiveId&&!ids.includes(directorActiveId))directorActiveId=null;renderDirector();
